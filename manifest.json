{
  "manifest_version": 3,
  "name": "YouTube Mix to Playlist Generator",
  "description": "Generate and copy shareable playlist URLs from YouTube Mix playlists with one click.",
  "version": "1.0.0",

  "permissions": ["tabs", "storage"],

  "host_permissions": ["https://www.youtube.com/*"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/content.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "YouTube Mix to Playlist Generator",
    "default_popup": "popup/popup.html"
  },

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "128": "icons/128.png"
  }
}
